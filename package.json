{
  "name": "mapdown",
  "version": "0.3.0",
  "description": "Edit any Markdown note as a mind map, with the text and the map kept in sync.",
  "main": "main.js",
  "scripts": {
    "dev": "rollup --config rollup.config.js -w",
    "build": "rollup --config rollup.config.js --environment BUILD:production",
    "typecheck": "tsc --noEmit --inlineSources false --skipLibCheck",
    "test": "node tests/regression.js",
    "e2e": "node tests/e2e.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "mindmap",
    "markdown"
  ],
  "author": "Ian Jin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leftlive/mapdown.git"
  },
  "bugs": {
    "url": "https://github.com/leftlive/mapdown/issues"
  },
  "homepage": "https://github.com/leftlive/mapdown#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^18.0.0",
    "@rollup/plugin-node-resolve": "^11.2.1",
    "@rollup/plugin-typescript": "^8.2.1",
    "@types/dom-to-image": "^2.6.4",
    "@types/node": "^14.14.37",
    "monkey-around": "^2.2.0",
    "obsidian": "^1.13.1",
    "rollup": "^2.32.1",
    "tslib": "^2.2.0",
    "typescript": "^4.2.4"
  },
  "dependencies": {
    "dom-to-image": "^2.6.0",
    "jszip": "^3.7.1",
    "katex": "^0.17.0",
    "svg.js": "^2.7.1"
  }
}
